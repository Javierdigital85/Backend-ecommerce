# ==================== FRONTEND CONFIGURATION ====================
FRONTEND_URL=http://localhost:5173

# ==================== BACKEND CONFIGURATION ====================
BACKEND_URL=http://localhost:3001

# ==================== JWT CONFIGURATION ====================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ==================== MERCADOPAGO CONFIGURATION ====================
# Environment: 'development' or 'production'
NODE_ENV=development

# TEST CREDENTIALS (for development)
MP_ACCESS_TOKEN_TEST=TEST-your-test-access-token-here

# PRODUCTION CREDENTIALS (for production - NEVER commit these values)
MP_ACCESS_TOKEN_PROD=APP_USR-your-production-access-token-here

# Webhook Secret (get this from MercadoPago dashboard)
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret-here

# ==================== MONGODB CONFIGURATION ====================
MONGO_DB_NAME=ecommerceDB
MONGO_DB_USER=your-mongodb-user
MONGO_DB_PASSWORD=your-mongodb-password
MONGO_DB_URI=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net/<db_name>?appName=ecommerce

# ==================== GOOGLE API (for chat feature) ====================
GOOGLE_API_KEY=your-google-api-key-here

